# Public URL of the site (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# ── Enquiry delivery (first configured method wins) ──────────────
# 1) Email via Resend (https://resend.com). CONTACT_FROM_EMAIL must be on a domain verified in Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=            # comma-separated list of inboxes that receive enquiries
CONTACT_FROM_EMAIL=          # e.g. "Cerebellum Website <enquiries@your-domain.com>"

# 2) Or a webhook — HTTPS endpoint that accepts JSON POSTs (CRM, Zapier, Formspree, etc.)
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=      # optional, sent as X-Enquiry-Secret

# 3) Local development only: print enquiries to the server console instead of sending.
#    Ignored in production builds.
# ENQUIRY_DELIVERY=log

# Without any of the above, forms show an honest "not connected" error — never a false success.

# Optional Cloudflare Turnstile spam protection (see src/lib/enquiry-delivery.ts)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Admin Panel (/admin) ─────────────────────────────────────────
# PostgreSQL connection. Leave empty to store content in ./.data (files on this server).
# Tables are created automatically on first use.
DATABASE_URL=                # e.g. postgres://user:password@host:5432/cerebellum
# DATABASE_SSL=true          # set when your database requires SSL
# DATABASE_SSL_REJECT_UNAUTHORIZED=false   # only for self-signed certificates

# Secret used to sign admin sessions. REQUIRED in production, at least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Admin login kept in this file (works without a database). Restart after changing.
# Changing ADMIN_PASSWORD signs this account out everywhere.
ADMIN_EMAIL=
ADMIN_PASSWORD=              # at least 10 characters, letters and numbers
# ADMIN_NAME=Administrator

# More admin accounts (stored in the database / .data):  npm run admin:create

# ── Logging ──────────────────────────────────────────────────────
# Server logs go to standard output (PM2 / systemd / cPanel "Node.js app" logs).
# In production each line is JSON. Passwords, tokens and cookies are never logged;
# visitors' emails and phone numbers are masked.
# LOG_LEVEL=info             # debug | info | warn | error
